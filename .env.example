# =====================================================================
# Vercel Environment Variables (Add these in Vercel Project Settings)
# =====================================================================

# 1. Django Secret Key (Generate a long random string in production)
DJANGO_SECRET_KEY=django-insecure-production-secret-key-change-this

# 2. Debug Mode (Set to False in production)
DJANGO_DEBUG=False

# 3. Allowed Hosts (Comma-separated hostnames or .vercel.app)
ALLOWED_HOSTS=.vercel.app,localhost,127.0.0.1,*

# 4. Database Connection URL (PostgreSQL / Neon recommended for production)
DATABASE_URL=postgresql://neondb_owner:password@ep-sample-host.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
